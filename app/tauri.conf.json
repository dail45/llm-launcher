{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Llama Launcher",
  "identifier": "dev.llamalauncher.app",
  "build": {
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"],
    "shortDescription": "llama.cpp launcher",
    "longDescription": "Presets, memory calculator, OpenAI-compatible router and remote access for llama.cpp",
    "windows": {
      "nsis": { "installMode": "currentUser", "languages": ["Russian", "English"] },
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
