#!/usr/bin/env python3
"""Fake llama-perplexity: PPL depends on the quant in the file name; supports KLD mode."""
import sys, re, os
a = sys.argv[1:]
def arg(n, d=None):
    return a[a.index(n) + 1] if n in a and a.index(n) + 1 < len(a) else d
m = os.path.basename(arg("-m", ""))
q = re.search(r"(Q\d)", m.upper()); bits = int(q.group(1)[1]) if q else 8
ppl = 6.0 + (8 - bits) * 0.08
chunks = int(arg("--chunks", "20"))
kld_base = arg("--kl-divergence-base")
if "--kl-divergence" in a:
    if not kld_base or not os.path.exists(kld_base):
        print("failed to open logits file", file=sys.stderr); sys.exit(1)
elif not arg("-f") or not os.path.exists(arg("-f")):
    print("error: failed to open file", file=sys.stderr); sys.exit(1)
print(f"perplexity: calculating perplexity over {chunks} chunks, n_ctx={arg('-c','512')}", file=sys.stderr, flush=True)
for i in range(1, chunks + 1):
    print(f"[{i}]{ppl + 0.3/i:.4f},", end="", flush=True)
print()
if kld_base and "--kl-divergence" not in a:
    open(kld_base, "wb").write(b"logits")
if "--kl-divergence" in a:
    kld = (8 - bits) * 0.01 + 0.002
    print("====== Perplexity statistics ======")
    print(f"Mean PPL(Q)                   : {ppl:10.6f} ± {0.04:10.6f}")
    print(f"Mean PPL(base)                : {6.0:10.6f} ± {0.04:10.6f}")
    print("====== KL divergence statistics ======")
    print(f"Mean    KLD: {kld:10.6f} ± {kld/50:10.6f}")
    print(f"99.0%   KLD: {kld*12:10.6f}")
    print("====== Token probability statistics ======")
    print(f"RMS Δp    : {1+(8-bits)*0.5:7.3f} ± 0.010 %")
    print(f"Same top p: {99.0-(8-bits)*1.2:7.3f} ± 0.100 %")
else:
    print(f"Final estimate: PPL = {ppl:.4f} +/- 0.04000")
