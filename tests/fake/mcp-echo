#!/usr/bin/env python3
"""Minimal MCP stdio server for tests: tools echo(text) and add(a, b)."""
import sys, json
TOOLS = [
    {"name": "echo", "description": "Echo the text back", "inputSchema": {"type": "object", "properties": {"text": {"type": "string"}}, "required": ["text"]}},
    {"name": "add", "description": "Add two numbers", "inputSchema": {"type": "object", "properties": {"a": {"type": "number"}, "b": {"type": "number"}}}},
]
for line in sys.stdin:
    try:
        m = json.loads(line)
    except Exception:
        continue
    if "id" not in m:
        continue
    meth, p = m.get("method"), m.get("params") or {}
    if meth == "initialize":
        r = {"protocolVersion": p.get("protocolVersion"), "capabilities": {"tools": {}}, "serverInfo": {"name": "echo-test", "version": "1"}}
    elif meth == "tools/list":
        r = {"tools": TOOLS}
    elif meth == "tools/call":
        args = p.get("arguments") or {}
        if p.get("name") == "echo":
            r = {"content": [{"type": "text", "text": "echo: " + str(args.get("text"))}]}
        elif p.get("name") == "add":
            r = {"content": [{"type": "text", "text": str(args.get("a", 0) + args.get("b", 0))}]}
        else:
            r = {"content": [{"type": "text", "text": "unknown tool"}], "isError": True}
    else:
        print(json.dumps({"jsonrpc": "2.0", "id": m["id"], "error": {"code": -32601, "message": "method not found"}}), flush=True); continue
    print(json.dumps({"jsonrpc": "2.0", "id": m["id"], "result": r}), flush=True)
