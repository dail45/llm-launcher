{
  "name": "Llama Launcher",
  "short_name": "Llama",
  "description": "Лаунчер локальных LLM на llama.cpp: модели, чат, мониторинг",
  "id": "./",
  "start_url": "./#/",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0f1115",
  "theme_color": "#161a21",
  "lang": "ru",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Чат", "url": "./#/chat", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "Инстансы", "url": "./#/instances", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] }
  ]
}
